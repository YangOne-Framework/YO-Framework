@{
    var theme = ViewBag.ThemeName as string;
}
<h2>Edit Theme: @theme</h2>




<select id="fileSelector">
    <option value="Assets/scss/style.scss">style.scss</option>
    <option value="Assets/js/script.js">script.js</option>
</select>

<div id="editor" style="height:500px;border:1px solid #ccc;"></div>

<iframe id="previewFrame" src="@Url.Action("LivePreview", new { theme })" width="100%" height="500" style="border:1px solid #ccc;margin-top:1rem;"></iframe>

<form method="post" asp-action="SaveFile">
    <input type="hidden" name="theme" value="@theme" />
    <input type="hidden" name="path" id="filePath" value="Assets/scss/style.scss" />
    <input type="hidden" name="content" id="fileContent" />
    <button type="submit">💾 Save</button>
</form>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.34.1/min/vs/loader.min.js"></script>
    <script>
        let editor;
        let currentPath = document.getElementById('filePath').value;
        let previewFrame = document.getElementById("previewFrame");

        function sendPreviewUpdate(type, content) {
            if (!previewFrame.contentWindow) return;
            previewFrame.contentWindow.postMessage({ type, content }, "*");
        }

        function getPreviewType(path) {
            if (path.endsWith(".scss")) return "css";
            if (path.endsWith(".js")) return "js";
            return "html";
        }

        require.config({ paths: { 'vs': 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.34.1/min/vs' }});
        require(['vs/editor/editor.main'], function () {
            monaco.editor.setTheme("vs-dark");
            editor = monaco.editor.create(document.getElementById("editor"), {
                value: "",
                language: "scss",
                automaticLayout: true
            });

            fetch(`/admin/theme/loadfile?theme=@theme&path=${currentPath}`)
                .then(res => res.text())
                .then(content => editor.setValue(content));

            editor.onDidChangeModelContent(() => {
                const content = editor.getValue();
                const type = getPreviewType(currentPath);
                sendPreviewUpdate(type, content);
            });
        });

        document.getElementById('fileSelector').addEventListener('change', function () {
            currentPath = this.value;
            document.getElementById('filePath').value = currentPath;

            fetch(`/admin/theme/loadfile?theme=@theme&path=${currentPath}`)
                .then(res => res.text())
                .then(content => editor.setValue(content));
        });

        document.querySelector("form").addEventListener("submit", function () {
            document.getElementById("fileContent").value = editor.getValue();
        });
    </script>
}
