@using YangOne.Identity.Extensions

<div class="nav-header">
    <a href="/" class="brand-logo" aria-label="YO Framework">
        <img class="logo-abbr" src="/assets/images/logo.svg" alt="">
        <img class="logo-compact" src="/assets/images/logo.svg" alt="">
        <img class="brand-title" src="/assets/images/logo.svg" alt="">
    </a>
    <div class="nav-control">
        <div class="hamburger">
            <span class="line"></span><span class="line"></span><span class="line"></span>
        </div>
    </div>
</div>

<header class="header">
    <div class="header-content">
        <nav class="navbar navbar-expand">
            <div class="collapse navbar-collapse justify-content-between">

                <!-- Left Section: Dashboard Title -->
                <div class="header-left">
                    <div class="dashboard_bar">
                      
                    </div>
                </div>

                <!-- Right Section -->
                <ul class="navbar-nav header-right">

                    <!-- Search Box -->
                    <li class="nav-item">
                        <form>
                            <div class="input-group search-area d-lg-inline-flex d-none me-3">
                                <span class="input-group-text" id="header-search">
                                    <button class="bg-transparent border-0" type="button" aria-label="header-search">
                                        <i class="flaticon-381-search-2"></i>
                                    </button>
                                </span>
                                <input type="text" class="form-control" placeholder="Search here" aria-label="Search" aria-describedby="header-search">
                            </div>
                        </form>
                    </li>

                    <!-- Theme Switch -->
                    <li class="nav-item dropdown notification_dropdown">
                        <a class="nav-link bell dz-theme-mode" href="javascript:void(0);" aria-label="theme-mode">
                            <i id="icon-light" class="fas fa-sun"></i>
                            <i id="icon-dark" class="fas fa-moon"></i>
                        </a>
                    </li>

                    <!-- Notifications -->
                    <li class="nav-item dropdown notification_dropdown">
                        <a class="nav-link ai-icon" href="javascript:void(0)" role="button" data-bs-toggle="dropdown">
                            <svg width="22" height="22" viewBox="0 0 28 28" fill="none">
                                <path d="M22.75 15.8V13.04C22.75..." fill="#0B2A97" />
                            </svg>
                            <div class="pulse-css"></div>
                        </a>
                        <div class="dropdown-menu rounded dropdown-menu-end">
                            <div class="widget-media dz-scroll p-3 height380">
                                <ul class="timeline">
                                    <li><div class="timeline-panel"><h6 class="mb-1">No new notifications</h6></div></li>
                                </ul>
                            </div>
                        </div>
                    </li>

                    <!-- User Profile Dropdown -->
                    <li class="nav-item dropdown header-profile">
                        <a class="nav-link" href="javascript:void(0)" role="button" data-bs-toggle="dropdown">
                          @*   @if (!string.IsNullOrEmpty(User.Identity.GetPicture()))
                            {
                                <img src="@User.Identity.GetPicture()?w=50&h=50&mode=crop" width="20" class="rounded-circle" alt="@User.Identity.GetFullName()" />
                            }
                            else
                            {
                                <img src="images/profile/17.jpg" width="20" class="rounded-circle" alt="User" />
                            } *@
                            <div class="header-info">
                                <span class="text-black"><strong>@User.Identity.GetFullName()</strong></span>
                                <p class="fs-12 mb-0">Administrator</p>
                            </div>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end">
                            <a href="/admin/user/changepassword" class="dropdown-item ai-icon">
                                <i class="material-icons">vertical_split</i> Change Password
                            </a>
                            <div class="dropdown-divider"></div>
                            <a href="#" class="dropdown-item ai-icon text-danger lo">
                                <i class="material-icons text-danger">&#xE879;</i> Logout
                            </a> 
                        </div>
                    </li>

                </ul>
            </div>
        </nav>
    </div>
</header>
