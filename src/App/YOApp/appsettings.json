{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DisableHttpsRedirection": false,
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=yodb;Persist Security Info=False;User ID=user;Password=password;MultipleActiveResultSets=true;Connection Timeout=30;Trust Server Certificate=True;",
    "JobConnection": "Server=localhost,1433;Database=yodb;Persist Security Info=False;User ID=user;Password=password;MultipleActiveResultSets=true;Connection Timeout=30;Trust Server Certificate=True;"

  },
  "RateLimiting": {
    "TokenLimit": 20,
    "TokensPerPeriod": 20,
    "ReplenishmentSeconds": 30
  },
  "YOOpenTelemetry": {
    "Enabled": true,
    "OtlpEndpoint": "http://localhost:4317",
    "EnableConsoleExporter": false,
    "TraceSamplingRate": 1.0,
    "EnableRuntimeInstrumentation": true,
    "EnableHttpClientInstrumentation": true,
    "EnableSqlClientInstrumentation": false,
    "EnableLogExport": false
  }
}