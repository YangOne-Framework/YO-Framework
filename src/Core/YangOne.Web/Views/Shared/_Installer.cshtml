<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>YO Installer</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Installer Custom CSS -->
    <link href="~/assets/js/install/installer.css" rel="stylesheet" />
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ['Plus Jakarta Sans', 'sans-serif'],
            },
            colors: {
              brand: {
                red: '#bf2e2e',
                dark: '#0f172a',
                gray: '#f8fafc'
              }
            },
            animation: {
              'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
            }
          }
        }
      }
    </script>

</head>
<body class="antialiased h-screen w-screen overflow-hidden bg-slate-50">
<div id="root" class="h-full w-full"></div>

<script src="/assets/js/install/installer.js"></script>
</body>
</html>