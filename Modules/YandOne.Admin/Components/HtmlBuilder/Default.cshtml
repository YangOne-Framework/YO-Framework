<link href="/Themes/Default/css/theme.css" rel="stylesheet" />
<script src="~/lib/json5/json5.min.js"></script>
<style>
    .setting-buttons .active {
        border: 1px solid #13a813;
    }

    .complex-object {
    }

    .sheet {
        min-height: 300px;
        /*min-width: 1024px;*/
        /*overflow: scroll;*/
    }

    .sticky-right {
        background: white;
        position: fixed;
        top: 0;
        right: 0;
        height: 100vh;
        z-index: 1;
        overflow: scroll !important;
    }

    .current-drop {
        border: 1px black solid;
    }

    .kachuwa-template-drop {
        position: relative;
    }

    .invoice-template-setting .k-component {
        margin: 0 10px;
    }

    .kachuwa-template-drop {
    }

        .kachuwa-template-drop:hover:before {
            /* ------- THIS IS THE MAGIC ----------------*/
            content: attr(data-hover);
            /* ------------------------------------------*/
            display: block;
            background: #2da707;
            position: absolute;
            /*top: 100%;*/
            left: 0;
            right: 0;
            font-size: 15px;
            /*padding: 15px;*/
        }

        .kachuwa-template-drop:hover:after {
            content: "";
            position: absolute;
            display: block;
            width: 0;
            height: 0;
            border: solid 10px transparent;
            /*border-bottom-color: #000;*/
            bottom: 0;
            left: 50%;
            margin-left: -10px;
            z-index: 2;
        }

    #svgbasics {
        position: absolute;
        left: 0px;
        top: 0px;
        border: solid 0px #484;
        z-index: -100;
    }

    .dragging-item {
        background-color: greenyellow;
    }

    .dragged-item {
        background-color: olive;
    }

    .components, .template-data-objects {
        list-style: none;
        background: #e8e8e8;
        padding: 5px;
        margin: 0;
        margin-top: 20px;
        max-height: 80vh;
        overflow-y: scroll;
    }

    .components {
        /*display: inline-flex;*/
    }

        .components li:hover, .template-data-objects li:hover {
            background: #efefef;
        }

        .components li, .template-data-objects li {
            padding: 20px 5px;
            margin: 0 0 0 20px;
            cursor: pointer;
        }

    .component-settings {
        background: #f2f2f2;
        /*margin-top: 20px;*/
    }

    .sheetcomponent-setting {
        /*display: none;*/
        height: 32px;
        border: 1px dashed #a6a6a6;
    }

        .sheetcomponent-setting i {
            margin: 8px;
        }


    .invoice-template-setting {
        clear: both;
        padding: 20px 0;
    }

    .component-settings .group {
        display: inline;
        float: left;
    }

    .sidebar-fixed {
        opacity: 1;
        width: 48px;
        height: 100%;
        position: fixed;
        left: 0;
        color: #666;
        font-size: 15px;
        transition: all .5s ease;
        -webkit-transition: all .5s ease;
        -moz-transition: all .5s ease;
        box-shadow: 0 2px 5px 0 rgba(0,0,0,0.26);
        opacity: 1;
        z-index: 9999999;
    }



        .sidebar-fixed li {
            height: 48px;
            line-height: 55px;
            text-align: center;
            cursor: pointer;
            transition: all .5s ease;
            -webkit-transition: all .5s ease;
            -moz-transition: all .5s ease;
            color: #fff;
            opacity: .6;
        }
</style>

