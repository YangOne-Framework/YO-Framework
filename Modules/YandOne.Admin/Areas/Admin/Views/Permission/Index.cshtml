@model IEnumerable<YangOne.Web.MasterRolePermission>

@{
    // Layout = "~/themes/shared/fullmoon/Views/shared/_layout.cshtml";
    int i = 0;
    List<UserRolesSelected> lstRoles = (List<UserRolesSelected>)ViewData["Roles"];
    long roleid = 0;
    if (Model != null && Model.Count() > 0 && Model.FirstOrDefault().RoleId != 0)
    {
        roleid = Model.FirstOrDefault().RoleId;
    }
    string chkd = string.Empty;
    string val = "false";
}
<section class="container-fluid">
    <div class="row">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="cardform-wrapper">
                <form action="/admin/permission/save" method="post">
                    <section class="form-section">
                        <div class="d-flex justify-content-between m-3">
                            <h4>Roles</h4>

                            <div class="checkbox-box-row">
                                <select name="RolePermission[0].RoleId" id="rolePermssionselect">
                                    @foreach (var item in lstRoles)
                                    {
                                        if (item.RoleId == roleid)
                                        {
                                            <option value="@item.RoleId" selected>@item.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@item.RoleId">@item.Name</option>
                                        }
                                    }
                                </select>
                            </div>

                        </div>


                        @foreach (var item in Model.GroupBy(x => x.ControllerName))
                        {
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-description">
                                        <h4>@item.Key</h4>
                                    </div>

                                </div>

                                <div class="col-md-8">
                                    <div class="forminput-section">
                                        <label class="my-2">
                                            Select All<input style="margin-left: 1rem;" type="checkbox" class="input_check select_all" data-id="@item.Key" />
                                        </label>
                                        <div class="row">
                                            @foreach (var route in Model.Where(x => x.ControllerName == item.Key))
                                            {
                                                {
                                                    chkd = string.Empty;
                                                    val = "false";
                                                }
                                                if (route.AllowAccess)
                                                {
                                                    val = "true";
                                                    chkd = "checked";
                                                }

                                                <div class="col-md-6">
                                                    <div class="checkbox-box-row">
                                                        <input type="hidden" value="@route.ApplicationControllerActionId" name="RolePermission[@i].ApplicationControllerActionId">
                                                        <input type="hidden" value="@route.ApplicationControllerId" name="RolePermission[@i].ApplicationControllerId">
                                                        <input type="checkbox" class="input_check @item.Key" id="@route.RouteUrl" value="@val" name="RolePermission[@i].AllowAccess" @chkd>
                                                        <label for="@route.RouteUrl"> @(string.IsNullOrEmpty(route.FriendlyName) ? route.RouteUrl : route.FriendlyName)</label><br>
                                                    </div>

                                                </div>
                                                { i++; }
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }


                        <div class="row">
                            <div class="d-flex justify-content-end">

                                <a href="/" class="btn btn-danger">Cancel</a>
                                <button type="submit" class="btn btn-primary">Save </button>
                            </div>
                        </div>
                    </section>
                </form>

            </div>
        </div>
    </div>
</section>
@section scripts {
    <script>
        $(document).ready(function () {

            $("#rolePermssionselect").change(function () {
                let val = $(this).val();
                window.location.href = "/admin/permission?id=" + val;
            })

            $(".input_check").click(function () {
                if ($(this).is(':checked')) {
                    $(this).val(true);
                } else {
                    $(this).val(false);
                }

            })
        });

        $('.select_all').on('click', function () {
            var id = $(this).attr("data-id")
            $("." + id).prop("checked", $(this).prop("checked"));
            if ($("." + id).is(':checked')) {
                $("." + id).val(true);
            } else {
                $("." + id).val(false);
            }
        })
    </script>

}